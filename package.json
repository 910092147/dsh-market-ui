{
  "name": "dsh-market-ui",
  "version": "0.2.7",
  "description": "DSH 插件市场：浏览/搜索 npm 社区插件，一键安装、卸载、更新、对比。DSH plugin marketplace for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-mine",
    "deepseek",
    "deepseek-harness",
    "harness",
    "client-plugin",
    "market",
    "marketplace",
    "plugin-market",
    "plugin-manager",
    "install",
    "update",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "NAMING.md",
    "LICENSE",
    "index.json"
  ],
  "scripts": {
    "check": "node --check host.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "zhou.j",
  "homepage": "https://github.com/910092147/dsh-market-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/910092147/dsh-market-ui.git"
  },
  "bugs": {
    "url": "https://github.com/910092147/dsh-market-ui/issues"
  }
}
